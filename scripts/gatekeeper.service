# DaemonPorts Gatekeeper - 多端口启动引导服务
#
# 安装:
#   cp gatekeeper /usr/local/bin/
#   cp gatekeeper.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gatekeeper
#
# 编译说明:
#   默认编译（Type=simple）: xmake
#   systemd 集成（Type=notify）: xmake f -D HAVE_SYSTEMD=y && xmake
#
# 启用 HAVE_SYSTEMD 编译后，将 Type 改为 notify，systemd 会等待
# gatekeeper 真正接管端口后才返回 "active" 状态。

[Unit]
Description=DaemonPorts Gatekeeper - 多端口启动引导
Documentation=https://github.com/your-repo/daemonPorts
After=network.target
Wants=network.target

[Service]
# ── 编译模式 ──────────────────────────────────
# 没有 -DHAVE_SYSTEMD 编译 → 用 Type=simple
# 有  -DHAVE_SYSTEMD 编译 → 用 Type=notify
# ──────────────────────────────────────────────
Type=notify

# ── 程序路径 ──────────────────────────────────
# 修改为实际的 gatekeeper 二进制路径
ExecStart=/usr/local/bin/gatekeeper /usr/local/etc/gatekeeper/config.json

# ── 可选：从 stdin 加载配置 ──────────────────
# ExecStart=/usr/local/bin/gatekeeper -
# StandardInput=file:/etc/gatekeeper/config.json

# ── 重启策略 ──────────────────────────────────
Restart=on-failure
RestartSec=5s

# ── 停止超时 ───────────────────────────────────
# gatekeeper 退出时要优雅关闭各端口后端(先 SIGTERM 等 10s 再 SIGKILL),
# 并 join 监听/监控线程;实测旧版退出流程最坏 142s,默认 90s 不够,
# 放宽到 150s 覆盖实测上限,避免 stop-sigterm timed out
TimeoutStopSec=150

# ── 资源限制 ──────────────────────────────────
LimitNOFILE=65536
LimitNPROC=1024

# ── 权限降级 ──────────────────────────────────
# 以非特权用户运行：后端、stop_command、控制端口 /run 的命令都继承该用户权限，
# 即使控制 token 泄露或被后端反攻，也无法直接获得 root。
# 该用户由 scripts/install-service.sh 自动创建；手动安装时先执行：
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin gatekeeper
User=gatekeeper
# 若后端需要监听 <1024 端口，取消注释授予 CAP_NET_BIND_SERVICE
# （仅绑定低端口的权限，不提升其他能力）：
# AmbientCapabilities=CAP_NET_BIND_SERVICE

# ── 安全加固 ──────────────────────────────────
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
# 沙箱内必须可写的目录白名单（以 gatekeeper 用户视角）：
#  - .9router / .dotfiles/bash/.9router：9router 数据
#  - .nvm / .omniroute：omniroute 二进制与 DATA_DIR（storage.sqlite、logs、server/.pid）
# 注意：服务以 gatekeeper 用户运行，后端（9router/omniroute 等）的数据目录
# 必须对 gatekeeper 用户可写（chown gatekeeper:gatekeeper <目录> 或相应 ACL），
# 否则后端会因写权限失败退出。配置目录属主由 install-service.sh 处理，
# 其余数据目录请按实际后端自行调整。
ReadWritePaths=/home/user/.9router /home/user/.dotfiles/bash/.9router /home/user/.nvm /home/user/.omniroute /usr/local/etc/gatekeeper

# ── 日志（默认走 journald）───────────────────
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target