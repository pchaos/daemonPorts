{
  "control": {
    "listen": ":29999",
    "auth": {
      "type": "token",
      "token": "gatekeeper-secret"
    },
    "pin": "4271",
    "max_connections": 20,
    "rate_limit_seconds": 60,
    "commands": [
      {
        "name": "stream-echo",
        "command": "echo line1 && sleep 0.1 && echo line2"
      }
    ]
  },
  "commands": [
    {
      "name": "disk-usage",
      "command": "df -h"
    },
    {
      "name": "process-list",
      "command": "ps aux --sort=-%cpu | head -10"
    },
    {
      "name": "check-ports",
      "command": "ss -tlnp"
    }
  ],
  "ports": [
    {
      "name": "9router",
      "enabled": true,
      "listen": ":20128",
      "command": "/home/user/.nvm/versions/node/current/bin/node /home/user/.nvm/versions/node/current/lib/node_modules/9router/cli.js start --host 0.0.0.0 -p 20128 --skip-update --no-browser",
      "stop_command": "/home/user/.nvm/versions/node/current/bin/node /home/user/9router/cli.js stop",
      "idle_minutes": 30,
      "monitor": {
        "enabled": true,
        "interval_seconds": 60,
        "log_dedup": "throttle"
      },
      "delay": 30000,
      "refresh_seconds": 15,
      "auto_restart": true
    }
  ]
}
