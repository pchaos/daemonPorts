{
  "control": {
    "listen": ":29999",
    "auth": {
      "type": "token",
      "token": "my-secret-token"
    },
    "pin": "1234",
    "max_connections": 20,
    "rate_limit_seconds": 60
  },
  "commands": [
    {
      "name": "disk-usage",
      "command": "df -h"
    },
    {
      "name": "process-list",
      "command": "ps aux --sort=-%cpu | head -10"
    },
    {
      "name": "restart-web",
      "command": "systemctl restart web-app"
    }
  ],
  "ports": [
    {
      "name": "web",
      "enabled": true,
      "listen": ":3000",
      "command": "./real-app --port 3000",
      "delay": 5000,
      "refresh_seconds": 3,
      "auto_restart": false
    },
    {
      "name": "api",
      "enabled": false,
      "listen": ":4000",
      "command": "./api-server --port 4000",
      "delay": 5000,
      "refresh_seconds": 3,
      "auto_restart": true
    }
  ]
}